[Unit]
Description=Warden IRC Services
Documentation=https://github.com/TehPeGaSuS/warden
# The network targets only exist for system units; a user unit ignores them.
After=network-online.target
Wants=network-online.target

[Service]
ExecReload=/bin/kill -HUP $MAINPID
ExecStart=@ABSOLUTE_BIN_DIR@/@PROGRAM_NAME@ --nofork
Restart=on-failure
Type=simple
WorkingDirectory=@CMAKE_INSTALL_PREFIX@

[Install]
# default.target exists for both user and system units (multi-user.target
# only for system ones, so "systemctl --user enable" did nothing at boot).
WantedBy=default.target
