[Unit]
After=network.target
Description=Warden IRC Services
Documentation=https://github.com/TehPeGaSuS/warden
After=network-online.target
Wants=network-online.target

[Service]
ExecReload=/bin/kill -HUP $MAINPID
ExecStart=@ABSOLUTE_BIN_DIR@/@PROGRAM_NAME@ --nofork
Restart=on-failure
Type=simple
WorkingDirectory=@CMAKE_INSTALL_PREFIX@

[Install]
WantedBy=multi-user.target

