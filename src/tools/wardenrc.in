WARDENPID="@INSTDIR@/data/warden.pid"
ANOPROG="@INSTDIR@/bin/warden"
LOG="@INSTDIR@/logs/"
ARCVERSION="@VERSION_FULL@"

isWardenRunning () {
	if [ ! -f $WARDENPID ] ; then
		echo "Warning: Warden is not currently running"
		exit 1
	fi

	PID=`cat $WARDENPID`
	kill -0 $PID 2>/dev/null
	if [ $? -ne 0 ] ; then
		echo "Warning: Warden is not currently running"
		exit 1
	fi
}

if [ ! -f $ANOPROG ] ; then
	echo "Error: $ANOPROG cannot be accessed"
	exit 1
fi

if [ "$UID" = "0" ] ; then
	echo "######################################";
	echo "# Warning: Do NOT run Warden as root! #";
	echo "######################################";
	exit 1
fi

if [ "$1" = "start" ] ; then
	if [ -f $WARDENPID ] ; then
		PID=`cat $WARDENPID`
		kill -0 $PID 2>/dev/null
		if [ $? -eq 0 ] ; then
			echo "Warning! Warden is already running"
			exit 1
		fi
	fi

	echo "Starting Warden"
	shift
	$ANOPROG $*

	if [ "$?" -ne "0" ] ; then
		echo ""
	        echo "Unfortunately it seems Warden did not start successfully"
                echo "This error has been logged in your Warden Log file"
                echo "Located in "$LOG""
                echo "This may help you diagnose the problem"
                echo "Further help may be available from https://github.com/TehPeGaSuS/warden/discussions"
		exit 1
	fi

elif [ "$1" = "stop" ] ; then
	isWardenRunning
	echo "Terminating Warden"
	kill -15 `cat $WARDENPID`

elif [ "$1" = "status" ] ; then
	if [ -f $WARDENPID ] ; then
		PID=`cat $WARDENPID`
		kill -0 $PID 2>/dev/null
		if [ $? -eq 0 ] ; then
		        echo "Warden is currently running"
		        exit 0
	        fi
	fi

	echo "Warden is not currently running"

elif [ "$1" = "restart" ] ; then
	isWardenRunning
	echo "Restarting Warden"
	kill -15 `cat $WARDENPID`
	sleep 1

	shift
	$ANOPROG $*

	if [ "$?" -ne "0" ] ; then
		echo ""
	        echo "Unfortunately it seems Warden did not start successfully"
                echo "This error has been logged in your Warden Log file"
                echo "Located in "$LOG""
                echo "This may help you diagnose the problem"
                echo "Further help may be available from https://github.com/TehPeGaSuS/warden/discussions"
		exit 1
	fi

elif [ "$1" = "rehash" ] ; then
	isWardenRunning
	echo "Saving Databases and Rehashing Configuration"
	kill -1 `cat $WARDENPID`

elif [ "$1" = "version" ] ; then
	$ANOPROG -version

elif [ "$1" = "help" ] ; then
	if [ "$2" = "paramlist" ] ; then
		$ANOPROG -help
	else
		echo "WardenRC is a remote control script for easy"
		echo "controlling of Warden from the command console"
		echo "$0 start          Start Warden."
		echo "$0 stop           Shutdown Warden"
		echo "$0 status         Show Warden's Status"
		echo "$0 restart        Restart Warden (Databases will be saved)."
		echo "$0 rehash         Rehash Configuration and Save Databases"
		echo "$0 version        Return Warden Version and Build Information"
		echo "$0 help           Show this help menu"
		echo "If you need further help please check the /docs/"
		echo "folder or make use of our extensive online support at"
		echo "https://github.com/TehPeGaSuS/warden/discussions"
	fi

else
	echo "Warden Remote Control ($ARCVERSION)"
	echo "Usage: $0 [start|stop|status|restart|rehash|version|help]"
fi
