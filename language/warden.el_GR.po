#, c-format
msgid "Type %soption for more information on a specific option."
msgstr "Γράψτε %sεπιλογή για περισσότερες πληροφορίες σχετικά με μια συγκεκριμένη επιλογή."

#: ../modules/botserv/bs_kick.cpp
#, c-format
msgid ""
