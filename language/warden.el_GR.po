#: ../modules/chanserv/cs_topichistory.cpp
#, c-format
msgid "Topic history for %s is now off."
msgstr "Το ιστορικό topic του %s είναι τώρα ανενεργό."

#: ../modules/chanserv/cs_topichistory.cpp
#, c-format
