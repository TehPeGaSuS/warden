msgstr "Schorsingsreden"

#: ../modules/chanserv/cs_suspend.cpp ../modules/nickserv/ns_list.cpp
#: ../modules/nickserv/ns_suspend.cpp
msgid "Suspended"
msgstr "Geschorst"

#: ../modules/chanserv/cs_suspend.cpp ../modules/nickserv/ns_suspend.cpp
msgid "Suspended by"
msgstr "Geschorst door"

#: ../modules/chanserv/cs_suspend.cpp ../modules/nickserv/ns_suspend.cpp
