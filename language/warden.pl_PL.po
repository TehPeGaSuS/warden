#: ../modules/operserv/os_session.cpp
#, c-format
msgid "The host %s currently has %d sessions with a limit of %d because it matches entry: %s."
msgstr "Host %s aktualnie posiada %d sesji z limitem %d, ponieważ pasuje do wpisu: %s."

