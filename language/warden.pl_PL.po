msgstr "Lista blokad trybów %s jest pełna, nie można zablokować %s."

#: ../modules/operserv/os_shutdown.cpp
#, c-format
msgid "The network name you specified is incorrect. Did you mean to run %s on a different network?"
msgstr "Podana nazwa sieci jest nieprawidłowa. Czy chodziło Ci o uruchomienie %s w innej sieci?"

#: ../include/language.h
#, c-format
